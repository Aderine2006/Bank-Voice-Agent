APP_NAME=BankVoice AI
APP_ENV=development
DEBUG=true

LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

STT_PROVIDER=faster_whisper
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_LANGUAGE=en

DATABASE_URL=sqlite:///./data/bankvoice.db

FAISS_INDEX_PATH=./data/faiss
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50

BANK_DATA_PATH=./data/banks
DEFAULT_BANK_ID=demo-bank

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

HOST=0.0.0.0
PORT=8000